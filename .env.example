# Development example only. Keep real credentials in your untracked .env.
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain
APP_NAME="RKA Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local development database: create database/database.sqlite first.
# DB_DATABASE is omitted so Laravel uses its absolute default SQLite path.
DB_CONNECTION=sqlite
# DB_FOREIGN_KEYS=true

# Production MySQL alternative: set these in the server's .env.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rka_database
# DB_USERNAME=rka_user
# DB_PASSWORD=

# File cache and sessions work for single-node development.
# Use a shared persistent cache in multi-node production for email deduplication.
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
# SESSION_DOMAIN=

# Sync does not need a queue worker; switch to database/redis only when configured.
QUEUE_CONNECTION=sync

# Private RKA supporting evidence uses the local disk explicitly.
FILESYSTEM_DISK=local

# 'log' is safe for development; it does not deliver email.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# To deliver reminder email after configuring your SMTP provider:
# MAIL_MAILER=smtp
# MAIL_HOST=mail.example.test
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# White-label defaults; individual organizations can override branding/settings.
RKA_CURRENCY=IDR
RKA_LOCALE=id
RKA_TIMEZONE=Asia/Jakarta
RKA_INVITATION_MAX_DAYS=30

# Automation: mail delivery is disabled by default.
# To enable, configure SMTP and Laravel scheduler (schedule:run every minute).
RKA_TASK_REMINDER_MAIL_ENABLED=false
RKA_TASK_REMINDER_DAYS_AHEAD=3

# Financial publication is gated until approved staging UAT and release sign-off.
RKA_ENABLE_OFFICIAL_PUBLICATION=false
