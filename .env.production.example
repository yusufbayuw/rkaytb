# Production configuration for aaPanel. Keep real values out of version control.
# Configure real credentials outside version control before installation.
APP_NAME="RKA Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rka.example.invalid

FILAMENT_PATH=admin
FILAMENT_AUTH_GUARD=web
FILAMENT_FILESYSTEM_DISK=local
RKA_STICKY_TABLE_HEADERS=true
RKA_TABLE_DRAG_SCROLL=true
LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rka_production
DB_USERNAME=rka_production
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

RKA_CURRENCY=IDR
RKA_LOCALE=id
RKA_TIMEZONE=Asia/Jakarta
RKA_INVITATION_MAX_DAYS=30
RKA_TASK_REMINDER_MAIL_ENABLED=false
RKA_TASK_REMINDER_DAYS_AHEAD=3
RKA_ENABLE_OFFICIAL_PUBLICATION=false
